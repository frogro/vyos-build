interfaces {
    loopback lo {
    }
}
service {
    ssh {
        port "22"
    }
}
system {
    console {
        device ttyS2 {
            speed "1500000"
        }
    }
    host-name "vyos"
    login {
        user vyos {
            authentication {
                plaintext-password "vyos"
            }
        }
    }
}
